NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitcal_ai"
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# OpenAI / Gemini API
OPENAI_API_KEY="sk-your-key-here"
GOOGLE_GEMINI_API_KEY="your-gemini-key-here"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRE="24h"
REFRESH_TOKEN_EXPIRE="30d"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID="your-apple-client-id"
APPLE_CLIENT_SECRET="your-apple-client-secret"

# Email Service
EMAIL_SERVICE="sendgrid"
SENDGRID_API_KEY="your-sendgrid-key"
EMAIL_FROM="noreply@fitcal.app"

# S3 / Cloud Storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="fitcal-ai-uploads"

# Redis (optional, for caching)
REDIS_URL="redis://localhost:6379"

# Sentry (error tracking)
SENTRY_DSN="your-sentry-dsn"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_ENV="development"

# App Config
NEXT_PUBLIC_APP_NAME="FitCal AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
